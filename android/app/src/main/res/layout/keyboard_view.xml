<!--
    Phase 2b layout — Typeless-style reorganization.

    Top row: IME switch on the left; @ / space / backspace / settings as a
    compact icon row on the right.
    Middle:  status label + large mic button (with cancel/retry overlay).
    Bottom:  single 改行 button, centered.

    The original large space bar and enter ↩ button have been removed from the
    visible layout (the enter button is kept as visibility="gone" so the
    existing Kotlin lifecycle — "during recording, enter = stop + transcribe +
    \n" — is not broken; users just invoke that flow via the 改行 button or
    the mic button instead).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Background"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_gravity="bottom"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

    <View
        style="@style/TopBar"
        android:id="@+id/view_top_bar"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ─── Top row ─────────────────────────────────────────────────── -->

    <ImageButton
        style="@style/RegularImage"
        android:id="@+id/btn_previous_ime"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#00000000"
        android:contentDescription="@string/btn_previous_ime_hint"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_previous_ime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_bar" />

    <LinearLayout
        android:id="@+id/top_icon_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_top_bar">

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_at_symbol"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@"
            android:textSize="18sp"
            android:contentDescription="@string/btn_at_symbol_hint" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_number_toggle"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="123"
            android:textSize="15sp"
            android:contentDescription="@string/btn_number_toggle_hint" />

        <ImageButton
            style="@style/RegularImage"
            android:id="@+id/btn_space_bar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_space_bar"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/btn_space_bar" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_cursor_left"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="◀"
            android:textSize="16sp"
            android:contentDescription="@string/btn_cursor_left_hint" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_cursor_right"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="▶"
            android:textSize="16sp"
            android:contentDescription="@string/btn_cursor_right_hint" />

        <com.example.whispertoinput.keyboard.BackspaceButton
            style="@style/RegularImage"
            android:id="@+id/btn_backspace"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#00000000"
            android:contentDescription="@string/backspace_button_hint"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_backspace" />

        <ImageButton
            style="@style/RegularImage"
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#00000000"
            android:contentDescription="@string/btn_previous_ime_hint"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_settings" />
    </LinearLayout>

    <!-- ─── Middle: status label + mic button ─────────────────────────── -->

    <TextView
        style="@style/RegularText"
        android:id="@+id/label_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="@string/whisper_to_input"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_mic_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_previous_ime" />

    <FrameLayout
        android:id="@+id/btn_mic_frame"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_status">

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:background="#00FFFFFF"
            android:contentDescription="@string/start_speech_to_text"
            android:scaleType="fitCenter"
            android:src="@drawable/mic_idle" />

        <ProgressBar
            android:id="@+id/pb_waiting_icon"
            style="?android:attr/progressBarStyle"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_margin="10dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="invisible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mic_ripples"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/mic_ripple_0"
                android:layout_width="107dp"
                android:layout_height="107dp"
                android:alpha="0"
                android:src="@drawable/mic_ripple_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/mic_ripple_1"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:alpha="0"
                android:src="@drawable/mic_ripple_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/mic_ripple_2"
                android:layout_width="123dp"
                android:layout_height="123dp"
                android:alpha="0"
                android:src="@drawable/mic_ripple_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/mic_ripple_3"
                android:layout_width="131dp"
                android:layout_height="131dp"
                android:alpha="0"
                android:src="@drawable/mic_ripple_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Cancel overlay (visible only while recording/transcribing) -->
    <ImageButton
        style="@style/RegularImage"
        android:id="@+id/btn_cancel"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="#00FFFFFF"
        android:contentDescription=""
        android:scaleType="fitCenter"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:layout_marginEnd="16dp"
        android:src="@drawable/btn_cancel"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@+id/btn_mic_frame"
        app:layout_constraintBottom_toBottomOf="@+id/btn_mic_frame"
        app:layout_constraintEnd_toStartOf="@+id/btn_mic_frame" />

    <!-- Retry button removed from view (user feedback: circular arrow was confusing
         and served no clear purpose). Kept as visibility="gone" so WhisperKeyboard's
         findViewById + setKeyboardStatus logic still resolves. -->
    <ImageButton
        style="@style/RegularImage"
        android:id="@+id/btn_retry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/btn_retry"
        android:contentDescription=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden: the old Enter ↩ button is retained so the recording-stop-
         with-newline code path in WhisperKeyboard.kt keeps compiling, but
         no longer shown on screen. The visible 改行 button below always
         inserts "\n", which covers the user-facing use case. -->
    <ImageButton
        style="@style/RegularImage"
        android:id="@+id/btn_enter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/btn_enter"
        android:contentDescription="@string/start_transcribing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ─── Bottom: 改行 + 送信 buttons, centered as pair ──────────────── -->

    <LinearLayout
        android:id="@+id/bottom_button_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_mic_frame">

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_newline"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/carbon_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="改行"
            android:textSize="16sp"
            android:contentDescription="@string/btn_newline_hint" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_send"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/carbon_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="送信"
            android:textSize="16sp"
            android:contentDescription="@string/btn_send_hint" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_clear_all"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/carbon_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="全消去"
            android:textSize="16sp"
            android:contentDescription="@string/btn_clear_all_hint" />
    </LinearLayout>

    <!-- ─── Kuroppi mode row: left = style cycle (tap), right = 対話 toggle ──── -->

    <LinearLayout
        android:id="@+id/kuroppi_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_button_row">

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_kuroppi"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="180dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/carbon_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="くろっぴー・そのまま"
            android:textSize="14sp"
            android:contentDescription="@string/btn_kuroppi_hint" />

        <TextView
            style="@style/RegularText"
            android:id="@+id/btn_conv_toggle"
            android:layout_width="90dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/carbon_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="対話OFF"
            android:textSize="14sp"
            android:contentDescription="@string/btn_conv_toggle_hint" />
    </LinearLayout>

    <!-- Calculator-style pad — 2-page GridLayout, toggled by btn_number_toggle (123).
         Page 1: digits (0-9) + common symbols (. , : / -).
         Page 2: extended symbols (¥ % & # @ ! ? * ( ) " ' + = ~).
         btn_pad_page_switch flips between pages. Each cell commits its text
         to the current field via onDigit() — same callback reused for digits
         & symbols (both are single-character insertions). -->
    <LinearLayout
        android:id="@+id/number_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kuroppi_row">

        <!-- Page 1: digits + common symbols -->
        <LinearLayout
            android:id="@+id/pad_page_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_digit_1" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="1" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_2" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="2" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_3" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="3" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p1_period" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="." android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_digit_4" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="4" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_5" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="5" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_6" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="6" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p1_comma" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="," android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_digit_7" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="7" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_8" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="8" android:textSize="18sp" />
                <TextView android:id="@+id/btn_digit_9" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="9" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p1_colon" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text=":" android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_pad_page_switch" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center" android:text="#+=" android:textSize="14sp"
                    android:contentDescription="@string/btn_pad_page_switch_hint" />
                <TextView android:id="@+id/btn_digit_0" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="0" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p1_slash" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="/" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p1_minus" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="-" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page 2: extended symbols -->
        <LinearLayout
            android:id="@+id/pad_page_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_sym_p2_yen" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="¥" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p2_percent" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="%" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p2_amp" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="&amp;" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p2_hash" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="#" android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_sym_p2_at" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="@" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p2_excl" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center" android:text="!" android:textSize="18sp" />
                <TextView android:id="@+id/btn_sym_p2_q" style="@style/RegularText"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
